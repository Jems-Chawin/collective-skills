{
  "name": "collective-skills-mcp",
  "version": "0.1.0",
  "description": "MCP server that captures AI problem-solving reasoning as structured cases for reuse",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "collective-skills-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts"
  },
  "keywords": ["mcp", "ai", "knowledge-base", "debugging", "reasoning", "collective"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jems-Chawin/collective-skills.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "better-sqlite3": "11.7.0",
    "@xenova/transformers": "2.17.2",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.15.3",
    "@types/uuid": "10.0.0",
    "tsx": "4.19.4",
    "typescript": "5.7.3"
  }
}
